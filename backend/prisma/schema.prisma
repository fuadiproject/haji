// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum StatusTTE {
  REQUESTED
  SIGNED
  REJECTED
}

model File {
  id       String  @id @default(cuid())
  filename String
  filepath String // URL ke bucket
  key      String // key dari MinIO/multer-s3
  mimetype String?
  size     Int?

  created_by String? // FK -> UserSuperApp.id
  updated_by String? // FK -> UserSuperApp.id
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  version    Int      @default(1)

  // Relations
  creator UserSuperApp? @relation("UserCreatedFile", fields: [created_by], references: [id], onDelete: SetNull)
  updater UserSuperApp? @relation("UserUpdatedFile", fields: [updated_by], references: [id], onDelete: SetNull)

  BannerDark  Banner[] @relation("BannerImageDark")
  BannerLight Banner[] @relation("BannerImageLight")

  @@index([created_by])
  @@index([updated_by])
}

model Banner {
  id          String   @id @default(cuid())
  title       String
  dark_image  String? // FK -> File.id
  light_image String? // FK -> File.id
  link        String
  description String?
  is_active   Boolean  @default(true)
  created_by  String? // FK -> UserSuperApp.id
  updated_by  String? // FK -> UserSuperApp.id
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // Relations
  creator UserSuperApp? @relation("UserCreatedBanner", fields: [created_by], references: [id], onDelete: SetNull)
  updater UserSuperApp? @relation("UserUpdatedBanner", fields: [updated_by], references: [id], onDelete: SetNull)

  // Image
  file_dark  File? @relation("BannerImageDark", fields: [dark_image], references: [id], onDelete: SetNull)
  file_light File? @relation("BannerImageLight", fields: [light_image], references: [id], onDelete: SetNull)

  @@index([created_by])
  @@index([updated_by])
}

model Hyperlink {
  id         String   @id @default(cuid())
  title      String
  link       String
  logo       String?
  is_active  Boolean  @default(true)
  created_by String? // FK -> UserSuperApp.id
  updated_by String? // FK -> UserSuperApp.id
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  creator UserSuperApp? @relation("UserCreatedHyperlink", fields: [created_by], references: [id], onDelete: SetNull)
  updater UserSuperApp? @relation("UserUpdatedHyperlink", fields: [updated_by], references: [id], onDelete: SetNull)

  @@index([created_by])
  @@index([updated_by])
}

model User {
  id   String  @id @default(cuid()) // internal PK
  nik  String  @unique // dipakai di semua FK
  nip  String? @unique
  nama String

  created_by String? // FK -> User.nip (self-reference)
  updated_by String? // FK -> User.nip (self-reference)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  version    Int       @default(1)

  @@index([created_by])
  @@index([updated_by])
}

model Notification {
  id         String   @id @default(cuid())
  type       String
  title      String
  message    String
  userId     String
  data       Json
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([userId])
  @@index([created_at])
  @@index([updated_at])
  @@index([type])
  @@index([title])
  @@index([message])
  @@index([data])
}

model UserSuperApp {
  id         String   @id @default(uuid(7))
  name       String
  email      String   @unique
  password   String
  role       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  createdHyperlinks Hyperlink[] @relation("UserCreatedHyperlink")
  updatedHyperlinks Hyperlink[] @relation("UserUpdatedHyperlink")

  createdFiles File[] @relation("UserCreatedFile")
  updatedFiles File[] @relation("UserUpdatedFile")

  createdBanners Banner[] @relation("UserCreatedBanner")
  updatedBanners Banner[] @relation("UserUpdatedBanner")

  @@index([email])
  @@index([created_at])
  @@index([updated_at])
}
