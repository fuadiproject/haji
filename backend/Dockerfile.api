# Stage 1: Dependencies
FROM node:20-alpine AS deps
# Install only essential build tools
RUN apk add --no-cache python3 make g++

WORKDIR /app

# # Copy package files
COPY package*.json ./

# Install dependencies with optimizations
RUN npm ci --only=production && \
    npm prune --production && \
    npm cache clean --force && \
    rm -rf /root/.npm

# Stage 2: Production
FROM node:20-alpine AS production

# Install only dumb-init
RUN apk add --no-cache dumb-init

# Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 appuser

WORKDIR /app

# Copy dependencies from deps stage
COPY --from=deps /app/node_modules ./node_modules

# Copy application code
COPY --chown=appuser:nodejs index.js ./
COPY --chown=appuser:nodejs src/ ./src/
COPY --chown=appuser:nodejs prisma/ ./prisma/

# Generate Prisma client and cleanup
ENV PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING=1
RUN npx prisma generate && \
    # Remove unused Prisma engines
    find node_modules/@prisma/engines -type f ! -name 'libquery_engine-linux-musl-openssl-*.so.node' -delete 2>/dev/null || true && \
    find node_modules/prisma -type f ! -name 'libquery_engine-linux-musl-openssl-*.so.node' -delete 2>/dev/null || true && \
    # Remove Prisma migrations and unnecessary files
    rm -rf /app/prisma/migrations && \
    rm -rf /tmp/* /var/cache/apk/*

# Use non-root user
USER appuser

# Environment
ENV NODE_ENV=production

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD node --version || exit 1

# Start the application
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "index.js", "--mode=api"] 
