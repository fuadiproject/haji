# Kafka Configuration - Kubernetes Helm Installation

# Required - Use NodePort for external access
KAFKA_BROKERS=10.105.211.221:9094,10.110.12.225:9094,10.107.28.24:9094
KAFKA_CLIENT_ID=be-surat-producer

# Optional
KAFKA_RETRIES=8
KAFKA_SSL=false

# SASL (if needed)
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# Topics
KAFKA_TOPIC_SURAT_MASUK_EVENTS=surat-masuk-events
KAFKA_TOPIC_AUDIT_LOGS=audit-logs
KAFKA_TOPIC_NOTIFICATION_REQUESTS=notification-requests